# Backend Environment Variables - Example Template
# =================================================
# Copy this file to .env and fill in your actual values
# NEVER commit actual secrets - only commit .env.example

# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (MongoDB: replica set 1 node có xác thực, xem docker-compose.yml)
# Ứng dụng kết nối bằng user nexus_app (quyền tối thiểu). Mật khẩu dưới đây chỉ dùng cho máy dev,
# khớp với giá trị mặc định trong docker-compose.yml.
# `directConnection=true` vì backend chạy NGOÀI Docker và không phân giải được tên `mongodb`
# mà replica set quảng bá; trong Docker, docker-compose.yml tự ghi đè bằng replicaSet=rs0.
MONGO_URI=mongodb://nexus_app:nexus_app_dev_password@localhost:27017/nexusmart?authSource=admin&directConnection=true
# Chỉ dùng cho `npm run schema:ensure` (tạo validator/chỉ mục, cần quyền cao hơn). Ứng dụng KHÔNG dùng.
MONGO_ADMIN_URI=mongodb://root:root_dev_password@localhost:27017/admin?authSource=admin&directConnection=true

# Keycloak Configuration
KEYCLOAK_BASE_URL=http://localhost:8180
KEYCLOAK_REALM=shofy
KEYCLOAK_CLIENT_ID=shofy-backend
KEYCLOAK_JWKS_URI=http://localhost:8180/realms/shofy/protocol/openid-connect/certs
KEYCLOAK_AUTHORITY=http://localhost:8180/realms/shofy
KEYCLOAK_CLIENT_SECRET=shofy-backend-dev-secret
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_CLIENT_SECRET=admin-cli-dev-secret

# CORS
STORE_URL=http://localhost:3001
ADMIN_URL=http://localhost:8081

# Cloudinary Configuration
CLOUDINARY_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_UPLOAD_PRESET=your-cloudinary-upload-preset-name

# Email (nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
# Legacy email fields (used by older controllers)
SERVICE=gmail
HOST=smtp.gmail.com

STRIPE_KEY=sk_test_your-stripe-secret-key

# JWT / Token secrets (legacy auth — superseded by Keycloak in new routes)
TOKEN_SECRET=change-me-to-a-random-string
JWT_SECRET_FOR_VERIFY=change-me-to-another-random-string

# ISR Revalidation (used by Next.js frontend)
REVALIDATION_SECRET=change-me-to-a-random-string

# Google Gemini AI Chatbot
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
CHATBOT_ENABLED=true
CHATBOT_RATE_LIMIT_PER_USER_PER_5MIN=20
CHATBOT_MAX_MESSAGE_CHARS=2000
CHATBOT_HISTORY_WINDOW=12
CHATBOT_MAX_TOOL_CALLS_PER_TURN=5

# VNPay sandbox (đăng ký tại https://sandbox.vnpayment.vn để lấy TMN code + hash secret)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:4000/api/v1/auth/payment/vnpay/return
VNPAY_IPN_URL=http://localhost:4000/api/v1/auth/payment/vnpay/ipn
