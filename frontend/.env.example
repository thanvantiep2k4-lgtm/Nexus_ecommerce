# Frontend Environment Variables - Example Template
# =================================================
# Copy this file to .env.local and fill in your actual values

# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Keycloak Configuration
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8180
NEXT_PUBLIC_KEYCLOAK_REALM=shofy
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=shofy-frontend


# ISR Revalidation (must match backend REVALIDATION_SECRET)
REVALIDATION_SECRET=change-me-to-a-random-string
