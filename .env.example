# ==============================
# NexusMart E-Commerce Environment
# ==============================

# MongoDB (replica set có xác thực). Mật khẩu chỉ dành cho máy dev; production phải đặt riêng.
# Nếu đổi, phải đổi cả MONGO_URI trong backend/.env và crm/.env cho khớp.
# User root/nexus_app/... chỉ được tạo khi volume dữ liệu còn trống (xem docs/PROJECT_PLAN.md mục 3).
MONGO_ROOT_USER=root
MONGO_ROOT_PASS=root_dev_password
MONGO_APP_PASS=nexus_app_dev_password
MONGO_BACKUP_PASS=nexus_backup_dev_password
MONGO_READONLY_PASS=nexus_readonly_dev_password

# Redis (hàng đợi job). Nếu đổi, phải đổi cả REDIS_URL trong backend/.env cho khớp.
REDIS_PASS=redis_dev_password
REDIS_PORT=6379

# PostgreSQL (for Keycloak)
PG_PORT=5433
PG_USER=keycloak
PG_PASS=keycloak_password
PG_DB=keycloak

# Keycloak Server
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin123

